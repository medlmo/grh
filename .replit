modules = ["postgresql-16", "nodejs-24", "python-base-3.13"]
[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
CORS_ORIGIN = "http://localhost:5000"
JWT_ACCESS_EXPIRES = "15m"
JWT_REFRESH_EXPIRES = "7d"
NODE_ENV = "development"
PORT = "4000"
UPLOAD_DIR = "./uploads"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && node dist/src/main.js"
waitForPort = 4000

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 4000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000
